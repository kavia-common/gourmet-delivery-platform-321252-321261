# Backend environment example for Gourmet Delivery Platform

# Security
JWT_SECRET=replace_with_secure_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# CORS - set to your frontend URL to restrict requests (multiple origins comma-separated)
# Example: http://localhost:3000,https://my-frontend.example.com
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HEADERS=*
ALLOWED_METHODS=*

# Frontend/site URLs (optional, used for docs/redirects if needed)
SITE_URL=http://localhost:3000
WS_URL=

# Database connectivity (pick ONE approach)
# 1) Direct SQLAlchemy URL (preferred if available)
#POSTGRES_URL=postgresql+psycopg://user:password@host:port/dbname

# 2) db_connection.txt file pattern (contains something like: "psql postgresql://user:pass@host:port/db")
#    The backend will read the first token containing a "postgresql://" URL.
DB_CONNECTION_FILE=db_connection.txt

# 3) Compose from parts
#POSTGRES_USER=
#POSTGRES_PASSWORD=
#POSTGRES_DB=
#POSTGRES_PORT=5432
#POSTGRES_HOST=localhost
